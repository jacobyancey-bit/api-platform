# Dangling Dice Studios™ — API Platform Environment Configuration
# Compatible alongside Dangling_Dice_Website (ports 3000/5000) & Code_Craft (ports 3001/4000/5432/6379)

# Database & Redis (matches docker-compose.yml)
DATABASE_URL="postgresql://dds_user:dds_password@localhost:5434/dangling_dice_api?schema=public"
REDIS_URL="redis://localhost:6381"

# Service Ports
GATEWAY_PORT=4100
WEB_PORT=3100

# Public URLs (Used by Next.js sandboxes, code snippet drawers, and CORS)
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4100"
NEXT_PUBLIC_SITE_URL="https://dangling-dice-studios.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3100,http://localhost:5000,https://dangling-dice-studios.com"

# Shared JWT Secret (Can share with Dangling_Dice_Website for unified creator SSO)
JWT_SECRET="dangling_dice_studios_unified_jwt_secret_2026"

# Stripe Metered Billing (Tier 2 Self-Serve API Subscriptions)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRICE_PRO_MONTHLY="price_pro_29_monthly"
STRIPE_PRICE_SCALE_MONTHLY="price_scale_99_monthly"
