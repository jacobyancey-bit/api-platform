            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coordinates\": [\n    [-97.7431, 30.2672],\n    [-97.7401, 30.2672],\n    [-97.7401, 30.2698],\n    [-97.7431, 30.2698]\n  ]\n}"
            },
            "url": "{{gatewayUrl}}/v1/geo/parcel-metrics"
          }
        },
        {
          "name": "POST /v1/geo/distance (Haversine Distance & Compass Bearing)",
          "request": {
            "method": "POST",
            "header": [
